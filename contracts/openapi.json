        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Chave em PolicyParams"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "kind": {
            "type": "string",
            "enum": [
              "number",
              "select"
            ],
            "title": "Kind"
          },
          "min": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min"
          },
          "max": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max"
          },
          "step": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Step"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "percent",
                  "brl",
                  "count"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          },
          "options": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ParamOption"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Options"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "title": "Value"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "label",
          "description",
          "kind",
          "value"
        ],
        "title": "ParamSpec"
      },
      "Pattern": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "sentence": {
            "type": "string",
            "title": "Sentence",
            "description": "Frase pronta no formato do manual"
          },
          "group_description": {
            "type": "string",
            "title": "Group Description"
          },
          "group_default_rate": {
            "type": "number",
            "title": "Group Default Rate"
          },
          "overall_default_rate": {
            "type": "number",
            "title": "Overall Default Rate"
          },
          "customers_affected": {
            "type": "integer",
            "title": "Customers Affected"
          },
          "direction": {
            "type": "string",
            "enum": [
              "worse",
              "better"
            ],
            "title": "Direction"
          },
          "current_policy_view": {
            "type": "string",
            "enum": [
              "approves",
              "denies",
              "mixed"
            ],
            "title": "Current Policy View",
            "description": "Como a política atual trata esse grupo"
          },
          "groups": {
            "items": {
              "$ref": "#/components/schemas/PatternGroup"
            },
            "type": "array",
            "title": "Groups",
            "description": "Barras do gráfico, já agregadas"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "sentence",
          "group_description",
          "group_default_rate",
          "overall_default_rate",
          "customers_affected",
          "direction",
          "current_policy_view",
          "groups"
        ],
        "title": "Pattern"
      },
      "PatternGroup": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "default_rate": {
            "type": "number",
            "title": "Default Rate"
          },
          "customers": {
            "type": "integer",
            "title": "Customers"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "label",
          "default_rate",
          "customers"
        ],
        "title": "PatternGroup"
      },
      "Policy": {
        "properties": {
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "approved_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approved At"
          },
          "approved_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approved By"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "params": {
            "$ref": "#/components/schemas/PolicyParams"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/PolicyStep"
            },
            "type": "array",
            "title": "Steps"
          },
          "param_specs": {
            "items": {
              "$ref": "#/components/schemas/ParamSpec"
            },
            "type": "array",
            "title": "Param Specs"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version",
          "approved_at",
          "approved_by",
          "params",
          "steps",
          "param_specs"
        ],
        "title": "Policy"
      },
      "PolicyParams": {
        "properties": {
          "min_score": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 0.0,
            "title": "Min Score",
            "description": "Nega com score do bureau até este valor",
            "default": 450
          },
          "min_income": {
            "type": "number",
            "maximum": 20000.0,
            "minimum": 0.0,
            "title": "Min Income",
            "description": "Nega com renda declarada até este valor",
            "default": 1500.0
          },
          "max_restrictions": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Max Restrictions",
            "description": "Nega acima deste número de restrições (1 restrição: 19–23% de calote no piloto; o modelo não as viu)",
            "default": 0
          },
          "max_outflow_ratio": {
            "type": "number",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Max Outflow Ratio",
            "description": "Nega se as saídas passam desta fração das entradas",
            "default": 0.9
          },
          "max_recent_overdraft_months": {
            "type": "integer",
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Max Recent Overdraft Months",
            "description": "Nega acima deste número de meses com cheque especial nos 3 antes do pedido",
            "default": 1
          },
          "max_drain": {
            "type": "number",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Max Drain",
            "description": "Nega se a maior saída recente passa X vezes a saída típica",
            "default": 3.0
          },
          "min_inflow_ratio": {
            "type": "number",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Min Inflow Ratio",
            "description": "Nega se as entradas cobrem menos que isto da renda declarada",
            "default": 0.6
          },
          "max_inquiries_90d": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 0.0,
            "title": "Max Inquiries 90D",
            "description": "Nega acima deste número de consultas ao CPF em 90 dias",
            "default": 7
          },
          "max_commitment": {
            "type": "number",
            "maximum": 0.5,
            "minimum": 0.05,
            "title": "Max Commitment",
            "description": "Parcela máxima sobre a renda efetiva",
            "default": 0.25
          },
          "amount_rule": {
            "type": "string",
            "enum": [
              "full_or_deny",
              "maximize_expected_profit"
            ],
            "title": "Amount Rule",
            "default": "full_or_deny"
          },
          "risk_cutoff": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Risk Cutoff",
            "description": "Nega com chance de calote acima disto (quem a política atual aprovaria)",
            "default": 0.15
          },
          "risk_cutoff_expansion": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Risk Cutoff Expansion",
            "description": "Mesmo corte para quem a política atual negaria (evidência só do piloto)",
            "default": 0.12
          },
          "safety_margin": {
            "type": "number",
            "maximum": 0.5,
            "minimum": 0.0,
            "title": "Safety Margin",
            "description": "Resultado esperado mínimo por real emprestado",
            "default": 0.0
          },
          "late_rate": {
            "type": "number",
            "maximum": 0.6,
            "minimum": 0.0,
            "title": "Late Rate",
            "description": "Chance de atraso usada na conta (não é previsível nos dados)",
            "default": 0.2
          },
          "min_amount": {
            "type": "number",
            "maximum": 30000.0,
            "minimum": 500.0,
            "title": "Min Amount",
            "default": 500.0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "PolicyParams",
        "description": "Every number of the proposed policy. Omitted fields take the default."
      },
      "PolicyStep": {
        "properties": {
          "order": {
            "type": "integer",
            "title": "Order"
          },
          "kind": {
            "type": "string",
            "enum": [
              "filter",
              "capacity",
              "risk",
              "amount",
              "limit"
            ],
            "title": "Kind"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "approve",
              "deny",
              "amount"
            ],
            "title": "Outcome",
            "description": "O que o passo decide: aprova, nega ou define o valor"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "rule_text": {
            "type": "string",
            "title": "Rule Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "order",
          "kind",
          "outcome",
          "title",
          "rule_text"
        ],
        "title": "PolicyStep"
      },
      "ResultBlock": {
        "properties": {
          "approved": {
            "type": "integer",
            "title": "Approved"
          },
          "denied": {
            "type": "integer",
            "title": "Denied"
          },
          "approved_amount": {
            "type": "number",
            "title": "Approved Amount"
          },
          "expected_result": {
            "type": "number",
            "title": "Expected Result",
            "description": "Resultado esperado em R$ pela regra +15% / +5% / -60%"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "approved",
          "denied",
          "approved_amount",
          "expected_result"
        ],
        "title": "ResultBlock"
      },
      "RiskBand": {
        "properties": {
          "band": {
            "type": "string",
            "title": "Band",
            "examples": [
              "5–10%"
            ]
          },
          "orders": {
            "type": "integer",
            "title": "Orders"
          },
          "observed_default_rate": {
            "type": "number",
            "title": "Observed Default Rate"
          },
          "current_result": {
            "type": "number",
            "title": "Current Result"
          },
          "proposed_result": {
            "type": "number",
            "title": "Proposed Result"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "band",
          "orders",
          "observed_default_rate",
          "current_result",
          "proposed_result"
        ],
        "title": "RiskBand"
      },
      "SimulationRequest": {
        "properties": {
          "params": {
            "$ref": "#/components/schemas/PolicyParams"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "params"
        ],
        "title": "SimulationRequest"
      },
      "SimulationResult": {
        "properties": {
          "params": {
            "$ref": "#/components/schemas/PolicyParams"
          },
          "historical": {
            "$ref": "#/components/schemas/HistoricalResult"
          },
          "new_orders": {
            "$ref": "#/components/schemas/NewOrdersResult"
          },
          "by_risk_band": {
            "items": {
              "$ref": "#/components/schemas/RiskBand"
            },
            "type": "array",
            "title": "By Risk Band"
          },
          "steps_impact": {
            "items": {
              "$ref": "#/components/schemas/StepImpact"
            },
            "type": "array",
            "title": "Steps Impact"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "params",
          "historical",
          "new_orders",
          "by_risk_band"
        ],
        "title": "SimulationResult"
      },
      "StepImpact": {
        "properties": {
          "step": {
            "type": "string",
            "title": "Step",
            "examples": [
              "Sinais de aperto na conta"
            ]
          },
          "denied_new_orders": {
            "type": "integer",
            "title": "Denied New Orders",
            "description": "Pedidos novos negados neste passo"
          },
          "historical_gain_if_removed": {
            "type": "number",
            "title": "Historical Gain If Removed",
            "description": "Quanto o resultado no histórico muda se o passo for desligado (negativo = o passo ajuda)"
          },
          "new_orders_gain_if_removed": {
            "type": "number",
            "title": "New Orders Gain If Removed",
            "description": "Mesma medida, estimada nos pedidos novos"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "step",
          "denied_new_orders",
          "historical_gain_if_removed",
          "new_orders_gain_if_removed"
        ],
        "title": "StepImpact"
      },
      "Summary": {
        "properties": {
          "new_orders_total": {
            "type": "integer",
            "title": "New Orders Total"
          },
          "historical_mature_total": {
            "type": "integer",
            "title": "Historical Mature Total"
          },
          "base_default_rate": {
            "type": "number",
            "title": "Base Default Rate"
          },
          "current_policy": {
            "$ref": "#/components/schemas/ResultBlock"
          },
          "proposed_policy": {
            "$ref": "#/components/schemas/ResultBlock"
          },
          "gain": {
            "type": "number",
            "title": "Gain",
            "description": "proposed_policy.expected_result - current_policy.expected_result"
          },
          "model": {
            "$ref": "#/components/schemas/ModelQuality"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "new_orders_total",
          "historical_mature_total",
          "base_default_rate",
          "current_policy",
          "proposed_policy",
          "gain",
          "model"
        ],
        "title": "Summary"
      }
    }
  }
}
